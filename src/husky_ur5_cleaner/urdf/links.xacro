  <link name="riser_link">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.15 0.5"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.15 0.5"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <inertia ixx="0.045417" ixy="0"      ixz="0"
              iyy="0.045417" iyz="0"
              izz="0.0075"/>
    </inertial>
  </link>

  <!-- Brush end-effector link -->
  <link name="brush_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.2"/></geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.2"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

</robot>